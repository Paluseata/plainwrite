{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plainwrite",
  "version": "1.0.3",
  "identifier": "app.plainwrite.desktop",
  "build": {
    "frontendDist": "../www/english"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Retro minimalist word processor",
    "longDescription": "A quiet little word processor inspired by the AlphaSmart Neo: eight files, a small pixel screen, nothing else.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "editors"
      },
      "rpm": {
        "release": "1"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
